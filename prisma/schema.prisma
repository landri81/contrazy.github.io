generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  VENDOR
  CLIENT
}

enum VendorStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum StripeConnectionStatus {
  NOT_CONNECTED
  PENDING
  CONNECTED
  ERROR
}

enum SubscriptionPlanKey {
  STARTER
  PRO
  BUSINESS
  ENTERPRISE
}

enum SubscriptionBillingInterval {
  MONTHLY
  YEARLY
}

enum VendorSubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
  INCOMPLETE_EXPIRED
  UNPAID
}

enum TransactionKind {
  PAYMENT
  DEPOSIT
  HYBRID
}

enum PaymentCollectionTiming {
  AFTER_SIGNING
  AFTER_SERVICE
}

enum TransactionStatus {
  DRAFT
  LINK_SENT
  CUSTOMER_STARTED
  DOCS_SUBMITTED
  KYC_VERIFIED
  CONTRACT_GENERATED
  SIGNED
  PAYMENT_AUTHORIZED
  COMPLETED
  CANCELLED
  DISPUTED
}

enum RequirementType {
  DOCUMENT
  PHOTO
  CAPTURE
  TEXT
}

enum DocumentAssetSource {
  UPLOAD
  LIVE_CAPTURE
}

enum TransactionCustomFieldType {
  TEXT
  NUMBER
  SELECT
}

enum RequirementCategory {
  ID
  PROOF_OF_ADDRESS
  DRIVER_LICENSE
  COMPANY_REGISTRATION
  CONTRACT_ATTACHMENT
  CUSTOM
  OTHER
}

enum KycStatus {
  NOT_REQUIRED
  PENDING
  VERIFIED
  FAILED
}

enum SignatureStatus {
  PENDING
  SIGNED
  EXPIRED
}

enum PaymentKind {
  SERVICE_PAYMENT
  DEPOSIT_AUTHORIZATION
  DEPOSIT_CAPTURE
  DEPOSIT_RELEASE
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  SUCCEEDED
  CAPTURED
  RELEASED
  FAILED
  CANCELLED
}

enum DepositStrategy {
  AUTHORIZATION_HOLD
  CHARGE_REFUND
}

enum TransactionLinkStatus {
  ACTIVE
  PROCESSING
  COMPLETED
  CANCELLED
}

enum TransactionLinkActor {
  VENDOR
  CLIENT
  ADMIN
  SYSTEM
}

enum BulkShareBatchStatus {
  CREATING
  COMPLETED
  PARTIAL
  FAILED
}

enum BulkShareRecipientStatus {
  PENDING
  EMAIL_SENT
  EMAIL_FAILED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  LOST
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  FAILED
}

enum AuditActorType {
  SYSTEM
  USER
  SUPER_ADMIN
}

enum LocaleCode {
  en
  fr
}

enum ContactMessageStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

enum TransactionFlowType {
  STANDARD
  CHECK_IN_OUT
}

enum TransactionReportType {
  CHECK_IN
  CHECK_OUT
}

enum TransactionReportStatus {
  PENDING
  SUBMITTED
  SIGNED
}

enum TransactionReportFieldType {
  TEXT
  NUMBER
  SELECT
}

enum TransactionEventType {
  LINK_CREATED
  TRANSACTION_RECREATED
  LINK_OPENED
  LINK_UPDATED
  LINK_CANCELLED
  CONTRACT_SNAPSHOT_CREATED
  PROFILE_SUBMITTED
  DOCUMENTS_SUBMITTED
  CUSTOM_FIELDS_SUBMITTED
  KYC_STARTED
  KYC_VERIFIED
  KYC_FAILED
  CONTRACT_REVIEWED
  SIGNATURE_COMPLETED
  SIGNED_PDF_GENERATED
  PAYMENT_SESSION_CREATED
  SERVICE_PAYMENT_REQUESTED
  SERVICE_PAYMENT_SUCCEEDED
  DEPOSIT_AUTHORIZED
  DEPOSIT_CAPTURED
  DEPOSIT_RELEASED
  DISPUTE_OPENED
  TRANSACTION_CANCELLED
  COMPLETED
  EMAIL_SENT
  WEBHOOK_PROCESSED
  CHECK_IN_SUBMITTED
  CHECK_OUT_REQUESTED
  CHECK_OUT_SUBMITTED
  DEPOSIT_CHARGED
  DEPOSIT_AUTO_REFUNDED
  DEPOSIT_AUTO_REFUND_SKIPPED
  DEPOSIT_REFUND_FAILED
}

model User {
  id               String               @id @default(cuid())
  name             String?
  email            String               @unique
  emailVerified    DateTime?
  image            String?
  passwordHash     String?
  role             UserRole             @default(VENDOR)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  accounts         Account[]
  sessions         Session[]
  vendorProfile    VendorProfile?
  clientProfiles   ClientProfile[]      @relation("ClientAccountProfiles")
  sentInvitations  Invitation[]         @relation("InvitationInviter")
  auditLogs        AuditLog[]           @relation("AuditActor")
  passwordResets   PasswordResetToken[]
}

model VendorProfile {
  id                     String                 @id @default(cuid())
  userId                 String                 @unique
  ownerFirstName         String?
  ownerLastName          String?
  businessName           String?
  businessSlug           String?                @unique
  businessEmail          String?
  supportEmail           String?
  businessPhone          String?
  businessAddress        String?
  businessCountry        String?
  registrationNumber     String?
  vatNumber              String?
  businessLogoUrl        String?
  businessLogoPublicId   String?
  businessLogoFileName   String?
  stripeAccountId        String?
  stripeConnectionStatus StripeConnectionStatus @default(NOT_CONNECTED)
  reviewStatus           VendorStatus           @default(PENDING)
  preferredLocale        LocaleCode             @default(en)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  user                   User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  clients                ClientProfile[]
  contractTemplates      ContractTemplate[]
  checklistTemplates     ChecklistTemplate[]
  transactions           Transaction[]
  bulkShareBatches       BulkShareBatch[]
  invitations            Invitation[]
  webhookEvents          WebhookEvent[]
  subscription           VendorSubscription?
}

model VendorSubscription {
  id                  String                       @id @default(cuid())
  vendorId            String                       @unique
  planKey             SubscriptionPlanKey
  billingInterval     SubscriptionBillingInterval
  status              VendorSubscriptionStatus
  stripeCustomerId    String?                      @unique
  stripeSubscriptionId String?                     @unique
  stripePriceId       String?
  stripeProductId     String?
  currentPeriodStart  DateTime?
  currentPeriodEnd    DateTime?
  cancelAtPeriodEnd   Boolean                      @default(false)
  trialStart          DateTime?
  trialEnd            DateTime?
  transactionsUsed    Int                          @default(0)
  eSignaturesUsed     Int                          @default(0)
  kycVerificationsUsed Int                         @default(0)
  qrCodesUsed         Int                          @default(0)
  smsWhatsappUsed     Int                          @default(0)
  teamUsersUsed       Int                          @default(0)
  usagePeriodStart    DateTime?
  usagePeriodEnd      DateTime?
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  vendor              VendorProfile                @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([status, currentPeriodEnd])
  @@index([planKey, billingInterval])
}

model ClientProfile {
  id          String          @id @default(cuid())
  userId      String?
  vendorId    String?
  fullName    String
  firstName   String?
  lastName    String?
  birthCity   String?
  birthDate   DateTime?       @db.Date
  email       String
  phone       String?
  companyName String?
  address     String?
  country     String?
  metadata    Json?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  user        User?           @relation("ClientAccountProfiles", fields: [userId], references: [id], onDelete: SetNull)
  vendor      VendorProfile?  @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  transactions Transaction[]
  documents   DocumentAsset[]
}

model ContractTemplate {
  id          String        @id @default(cuid())
  vendorId    String
  name        String
  description String?
  content     String        @db.Text
  isDefault   Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  vendor      VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  transactions Transaction[]
}

model ChecklistTemplate {
  id           String          @id @default(cuid())
  vendorId     String
  name         String
  description  String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  vendor       VendorProfile   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  items        ChecklistItem[]
  transactions Transaction[]
}

model ChecklistItem {
  id          String           @id @default(cuid())
  templateId  String
  label       String
  description String?
  type        RequirementType  @default(DOCUMENT)
  category    RequirementCategory @default(CUSTOM)
  customCategoryLabel String?
  requiredFileCount    Int     @default(1)
  fileSlotLabels       Json?
  exampleImageUrl      String?
  exampleImagePublicId String?
  exampleImageFileName String?
  required    Boolean          @default(true)
  sortOrder   Int              @default(0)
  template    ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

model Transaction {
  id                 String             @id @default(cuid())
  vendorId           String
  clientProfileId    String?
  bulkBatchId         String?
  contractTemplateId String?
  checklistTemplateId String?
  reference          String             @unique
  title              String
  kind               TransactionKind    @default(HYBRID)
  status             TransactionStatus  @default(DRAFT)
  flowType           TransactionFlowType @default(STANDARD)
  paymentCollectionTiming PaymentCollectionTiming @default(AFTER_SIGNING)
  currency           String             @default("EUR")
  amount             Int?
  depositAmount      Int?
  depositHoldDays    Int                @default(7)
  depositLongTermStripeFeeEstimateAmount Int?
  depositLongTermPlatformFeeAmount Int?
  depositLongTermFeeAcceptedAt DateTime?
  requiresKyc        Boolean            @default(false)
  requireClientCompany Boolean          @default(false)
  stripePaymentIntentId String?
  servicePaymentRequestedAt DateTime?
  checkOutRequestedAt DateTime?
  customerCompletedAt DateTime?
  signatureCity      String?
  serviceDate        DateTime?          @db.Date
  notes              String?            @db.Text
  locale             LocaleCode         @default(en)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  vendor             VendorProfile      @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  clientProfile      ClientProfile?     @relation(fields: [clientProfileId], references: [id], onDelete: SetNull)
  bulkBatch          BulkShareBatch?    @relation(fields: [bulkBatchId], references: [id], onDelete: SetNull)
  bulkRecipient      BulkShareRecipient?
  contractTemplate   ContractTemplate?  @relation(fields: [contractTemplateId], references: [id], onDelete: SetNull)
  checklistTemplate  ChecklistTemplate? @relation(fields: [checklistTemplateId], references: [id], onDelete: SetNull)
  link               TransactionLink?
  requirements       TransactionRequirement[]
  customFields       TransactionCustomField[]
  customFieldResponses TransactionCustomFieldResponse[]
  documents          DocumentAsset[]
  kycVerification    KycVerification?
  signatureRecord    SignatureRecord?
  contractArtifact   TransactionContractArtifact?
  payments           Payment[]
  depositAuthorization DepositAuthorization?
  dispute            Dispute?
  events             TransactionEvent[]
  webhookEvents      WebhookEvent[]
  reportFields       TransactionReportField[]
  reports            TransactionReport[]

  @@index([vendorId, createdAt])
  @@index([bulkBatchId])
  @@index([status])
}

model TransactionReportField {
  id            String                    @id @default(cuid())
  transactionId String
  reportType    TransactionReportType
  label         String
  instructions  String?
  fieldType     TransactionReportFieldType @default(TEXT)
  selectOptions Json?
  sortOrder     Int                        @default(0)
  transaction   Transaction               @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  responses     TransactionReportResponse[]

  @@index([transactionId, reportType])
}

model TransactionReport {
  id            String                  @id @default(cuid())
  transactionId String
  type          TransactionReportType
  status        TransactionReportStatus @default(PENDING)
  submittedAt   DateTime?
  artifactHtml  String?                 @db.Text
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  transaction   Transaction             @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  responses     TransactionReportResponse[]
  assets        TransactionReportAsset[]

  @@unique([transactionId, type])
  @@index([transactionId])
}

model TransactionReportResponse {
  id        String                 @id @default(cuid())
  reportId  String
  fieldId   String
  value     String                 @db.Text
  report    TransactionReport      @relation(fields: [reportId], references: [id], onDelete: Cascade)
  field     TransactionReportField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([reportId, fieldId])
}

model TransactionReportAsset {
  id        String            @id @default(cuid())
  reportId  String
  assetUrl  String
  publicId  String
  fileName  String
  mimeType  String?
  sortOrder Int               @default(0)
  report    TransactionReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

model BulkShareBatch {
  id              String               @id @default(cuid())
  vendorId        String
  sourceFileName  String?
  configSnapshot  Json?
  recipientCount  Int                  @default(0)
  sentCount       Int                  @default(0)
  failedCount     Int                  @default(0)
  status          BulkShareBatchStatus @default(CREATING)
  completedAt     DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  vendor          VendorProfile        @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  transactions    Transaction[]
  recipients      BulkShareRecipient[]

  @@index([vendorId, createdAt])
  @@index([status, createdAt])
}

model BulkShareRecipient {
  id              String                   @id @default(cuid())
  batchId         String
  transactionId   String?                  @unique
  email           String
  normalizedEmail String
  status          BulkShareRecipientStatus @default(PENDING)
  errorMessage    String?                  @db.Text
  sentAt          DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  batch           BulkShareBatch           @relation(fields: [batchId], references: [id], onDelete: Cascade)
  transaction     Transaction?             @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@unique([batchId, normalizedEmail])
  @@index([normalizedEmail])
  @@index([status, createdAt])
}

model TransactionLink {
  id            String      @id @default(cuid())
  transactionId String      @unique
  token         String      @unique
  shortCode     String?     @unique
  qrCodeSvg     String?     @db.Text
  status        TransactionLinkStatus @default(ACTIVE)
  expiresAt     DateTime?
  openedAt      DateTime?
  completedAt   DateTime?
  cancelledAt   DateTime?
  cancelReason  String?     @db.Text
  cancelledBy   TransactionLinkActor?
  createdAt     DateTime    @default(now())
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

model TransactionRequirement {
  id            String          @id @default(cuid())
  transactionId String
  label         String
  instructions  String?
  type          RequirementType @default(DOCUMENT)
  category      RequirementCategory @default(CUSTOM)
  customCategoryLabel String?
  requiredFileCount    Int      @default(1)
  fileSlotLabels       Json?
  exampleImageUrl      String?
  exampleImagePublicId String?
  exampleImageFileName String?
  required      Boolean         @default(true)
  sortOrder     Int             @default(0)
  transaction   Transaction     @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  documents     DocumentAsset[]
}

model TransactionCustomField {
  id            String                     @id @default(cuid())
  transactionId String
  label         String
  instructions  String?
  type          TransactionCustomFieldType @default(TEXT)
  selectOptions Json?
  sortOrder     Int                        @default(0)
  transaction   Transaction                @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  response      TransactionCustomFieldResponse?
}

model TransactionCustomFieldResponse {
  id            String                 @id @default(cuid())
  transactionId String
  customFieldId String                 @unique
  value         String                 @db.Text
  answeredAt    DateTime               @default(now())
  transaction   Transaction            @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  customField   TransactionCustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)

  @@index([transactionId, answeredAt])
}

model DocumentAsset {
  id              String         @id @default(cuid())
  transactionId   String
  clientProfileId String?
  requirementId   String?
  label           String
  type            RequirementType @default(DOCUMENT)
  slotIndex       Int            @default(0)
  slotLabel       String?
  source          DocumentAssetSource @default(UPLOAD)
  capturedAt      DateTime?
  fileName        String?
  assetUrl        String?
  textValue       String?        @db.Text
  publicId        String?
  uploadedAt      DateTime       @default(now())
  transaction     Transaction    @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  clientProfile   ClientProfile? @relation(fields: [clientProfileId], references: [id], onDelete: SetNull)
  requirement     TransactionRequirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)

  @@unique([transactionId, requirementId, slotIndex])
}

model KycVerification {
  id                String     @id @default(cuid())
  transactionId     String     @unique
  provider          String     @default("Stripe Identity")
  status            KycStatus  @default(PENDING)
  providerReference String?
  summary           String?
  verifiedAt        DateTime?
  createdAt         DateTime   @default(now())
  transaction       Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
}

model SignatureRecord {
  id               String          @id @default(cuid())
  transactionId    String          @unique
  status           SignatureStatus @default(PENDING)
  signerName       String?
  signerEmail      String?
  method           String?         @default("Canvas Signature")
  signatureDataUrl String?         @db.Text
  typedValue       String?
  fontKey          String?
  ipAddress        String?
  signedAt         DateTime?
  createdAt        DateTime        @default(now())
  transaction      Transaction     @relation(fields: [transactionId], references: [id], onDelete: Cascade)
}

model TransactionContractArtifact {
  id                           String      @id @default(cuid())
  transactionId                String      @unique
  sourceTemplateId             String?
  sourceTemplateName           String?
  sourceTemplateDescription    String?
  templateContentSnapshot      String?     @db.Text
  renderedContentBeforeSignature String?   @db.Text
  renderedContentAfterSignature  String?   @db.Text
  signatureImageUrl            String?
  signatureImagePublicId       String?
  signedPdfUrl                 String?
  signedPdfPublicId            String?
  signedPdfHash                String?
  reviewCompletedAt            DateTime?
  generatedAt                  DateTime    @default(now())
  signedAt                     DateTime?
  signedTimezone               String?
  updatedAt                    DateTime    @updatedAt
  transaction                  Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([signedAt])
}

model Payment {
  id              String        @id @default(cuid())
  transactionId   String
  kind            PaymentKind
  status          PaymentStatus @default(PENDING)
  amount          Int
  currency        String        @default("EUR")
  stripeFeeAmount Int?
  platformFeeAmount Int?
  vendorNetAmount Int?
  stripeIntentId  String?
  processedAt     DateTime?
  createdAt       DateTime      @default(now())
  transaction     Transaction   @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@unique([transactionId, kind])
}

model DepositAuthorization {
  id                    String          @id @default(cuid())
  transactionId         String          @unique
  status                PaymentStatus   @default(PENDING)
  depositStrategy       DepositStrategy @default(AUTHORIZATION_HOLD)
  amount                Int
  currency              String          @default("EUR")
  stripeIntentId        String?
  authorizedAt          DateTime?
  capturedAt            DateTime?
  releasedAt            DateTime?
  depositAutoRefundAt   DateTime?
  depositChargedAt      DateTime?
  depositRefundedAt     DateTime?
  depositRefundId       String?
  depositCapturedAmount Int?
  depositRefundedAmount Int?
  transaction           Transaction     @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([depositStrategy, depositAutoRefundAt])
}

model Dispute {
  id                String        @id @default(cuid())
  transactionId     String        @unique
  status            DisputeStatus @default(OPEN)
  summary           String        @db.Text
  evidenceImages    Json?
  resolution        String?       @db.Text
  resolvedByAdminId String?
  openedAt          DateTime      @default(now())
  resolvedAt        DateTime?
  transaction       Transaction   @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([status, openedAt])
}

model Invitation {
  id         String           @id @default(cuid())
  email      String
  role       UserRole
  token      String           @unique
  vendorId   String?
  inviterId  String?
  status     InvitationStatus @default(PENDING)
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime         @default(now())
  vendor     VendorProfile?   @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  inviter    User?            @relation("InvitationInviter", fields: [inviterId], references: [id], onDelete: SetNull)

  @@index([email, status])
}

model AuditLog {
  id         String         @id @default(cuid())
  actorId    String?
  actorType  AuditActorType @default(USER)
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime       @default(now())
  actor      User?          @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entityType, entityId])
}

model WebhookEvent {
  id              String        @id @default(cuid())
  vendorId        String?
  transactionId   String?
  provider        String
  providerEventId String?
  eventType       String
  status          WebhookStatus @default(RECEIVED)
  error           String?       @db.Text
  payload         Json?
  createdAt       DateTime      @default(now())
  vendor          VendorProfile? @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  transaction     Transaction?   @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([provider, eventType])
  @@index([vendorId, createdAt])
  @@index([transactionId])
  @@index([status, createdAt])
  @@unique([provider, providerEventId])
}

model TransactionEvent {
  id          String               @id @default(cuid())
  transactionId String
  type        TransactionEventType
  dedupeKey   String?              @unique
  title       String
  detail      String?
  metadata    Json?
  occurredAt  DateTime             @default(now())
  createdAt   DateTime             @default(now())
  transaction Transaction          @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId, occurredAt])
  @@index([type])
}

model ContactMessage {
  id         String               @id @default(cuid())
  firstName  String
  lastName   String
  email      String
  message    String               @db.Text
  locale     LocaleCode           @default(en)
  status     ContactMessageStatus @default(NEW)
  repliedAt  DateTime?
  replyText  String?              @db.Text
  ipAddress  String?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@index([status, createdAt])
  @@index([email])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
