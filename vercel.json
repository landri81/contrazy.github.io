{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm ci --include=dev",
  "buildCommand": "npm run vercel-build",
  "crons": [
    {
      "path": "/api/cron/deposit-auto-refunds",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/partner-webhooks",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/card-security",
      "schedule": "23 3 * * *"
    },
    {
      "path": "/api/cron/post-charge-retries",
      "schedule": "41 * * * *"
    }
  ]
}
